# NexusCorp backend configuration (copy to .env and adjust).
# os.environ always wins over values in .env. Secrets are never logged or printed.

# paper = simulated fills only; live requires MODE=live AND LIVE_ENABLED=true
MODE=paper
LIVE_ENABLED=false

# Solana pubkey whose real chain balances appear in /wallet (blank = paper only)
WALLET_PUBKEY=
RPC_URL=https://api.mainnet-beta.solana.com

# Alert channels (leave blank to disable; scribe becomes a no-op)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_FINDER_CHANNEL_ID=
DISCORD_COPY_CHANNEL_ID=
DISCORD_YIELD_CHANNEL_ID=
ALLOWED_DISCORD_USER_ID=0

# Yield decision rules
MIN_EDGE_APY=0.40
MIN_MOVE_USD=200
MIN_TVL_USD=250000
GAS_BUFFER_USD=200
ALLOWLIST_PROJECTS=kamino-lend,jupiter-lend,save
ALLOWLIST_SYMBOLS=USDC

# Scheduler intervals (seconds)
LOOP_SECONDS=3600
FINDER_SCAN_SECONDS=90
COPY_POLL_SECONDS=45
TRADE_MARK_SECONDS=30

# Desk settings
FINDER_EXECUTION=alerts
FINDER_MAX_TRACKED=40
COPY_EXECUTION=paper
COPY_TRADE_USD=25
MAX_LIVE_USD=100
